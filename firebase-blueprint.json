        "equipmentName": {
          "type": "string",
          "maxLength": 120
        },
        "type": {
          "type": "string",
          "enum": [
            "Preventive Maintenance",
            "Corrective Maintenance",
            "Inspection",
            "Calibration",
            "Safety Testing"
          ],
          "maxLength": 40
        },
        "lastMaintenanceDate": {
          "type": "string",
          "maxLength": 32
