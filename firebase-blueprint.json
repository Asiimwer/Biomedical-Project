            "Critical",
            "High",
            "Medium",
            "Low"
          ],
          "maxLength": 20
        },
        "status": {
          "type": "string",
          "enum": [
            "Scheduled",
            "In Progress",
            "Completed",
            "Overdue",
            "Awaiting Parts"
          ],
          "maxLength": 32
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        },
        "workPerformed": {
          "type": "string",
          "maxLength": 1000
        },
        "faultsDiscovered": {
          "type": "string",
          "maxLength": 1000
        },
        "partsReplaced": {
          "type": "string",
          "maxLength": 500
        },
        "completionDate": {
          "type": "string",
          "maxLength": 32
        },
        "completedBy": {
          "type": "string",
          "maxLength": 100
        },
        "postCondition": {
          "type": "string",
          "maxLength": 64
        },
        "recommendations": {
          "type": "string",
          "maxLength": 1000
        },
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "equipmentId",
        "assetId",
        "equipmentName",
        "type",
        "lastMaintenanceDate",
        "nextMaintenanceDate",
        "assignedEngineer",
        "priority",
        "status",
        "instructions",
        "workPerformed",
        "faultsDiscovered",
        "partsReplaced",
        "completionDate",
        "completedBy",
        "postCondition",
        "recommendations",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
