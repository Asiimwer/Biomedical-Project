{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated hospital BEMS user profile with RBAC role assignment.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": [
            "Administrator",
            "Biomedical Engineer",
            "Department Personnel",
            "Read-Only/Auditor"
          ],
          "maxLength": 40
        },
        "department": {
          "type": "string",
          "maxLength": 80
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "department",
        "createdAt",
        "updatedAt"
      ]
    },
    "EquipmentAsset": {
      "title": "EquipmentAsset",
      "description": "Registered biomedical medical device record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Z0-9\\-]+$",
          "maxLength": 32
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "manufacturer": {
          "type": "string",
          "maxLength": 80
        },
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "serialNumber": {
          "type": "string",
          "maxLength": 64
        },
        "department": {
          "type": "string",
          "maxLength": 80
        },
        "location": {
          "type": "string",
          "maxLength": 120
        },
        "condition": {
          "type": "string",
          "enum": [
            "Excellent",
            "Good",
            "Fair",
            "Needs Repair",
            "Unserviceable"
          ],
          "maxLength": 32
        },
        "status": {
          "type": "string",
          "enum": [
            "Operational",
            "Faulty",
            "Under Maintenance",
            "Awaiting Inspection",
            "Decommissioned"
          ],
          "maxLength": 32
        },
        "responsibleParty": {
          "type": "string",
          "maxLength": 100
        },
        "lastHandler": {
          "type": "string",
          "maxLength": 100
        },
        "lastMovementAt": {
          "type": "string",
          "maxLength": 40
        },
        "acquisitionDate": {
          "type": "string",
          "maxLength": 32
        },
        "lastServiceDate": {
          "type": "string",
          "maxLength": 32
        },
        "nextServiceDate": {
          "type": "string",
          "maxLength": 32
        },
        "lastUpdated": {
          "type": "string",
          "maxLength": 40
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "assetId",
        "name",
        "category",
        "manufacturer",
        "model",
        "serialNumber",
        "department",
        "location",
        "condition",
        "status",
        "responsibleParty",
        "lastHandler",
        "lastMovementAt",
        "acquisitionDate",
        "lastServiceDate",
        "nextServiceDate",
        "lastUpdated",
        "notes",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "EquipmentMovement": {
      "title": "EquipmentMovement",
      "description": "Chain-of-custody movement and transfer record between hospital locations.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "equipmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Z0-9\\-]+$",
          "maxLength": 32
        },
        "equipmentName": {
          "type": "string",
          "maxLength": 120
        },
        "originDepartment": {
          "type": "string",
          "maxLength": 80
        },
        "originLocation": {
          "type": "string",
          "maxLength": 120
        },
        "destinationDepartment": {
          "type": "string",
          "maxLength": 80
        },
        "destinationLocation": {
          "type": "string",
          "maxLength": 120
        },
        "authorizingPerson": {
          "type": "string",
          "maxLength": 100
        },
        "releasingPerson": {
          "type": "string",
          "maxLength": 100
        },
        "receivingPerson": {
          "type": "string",
          "maxLength": 100
        },
        "movementDate": {
          "type": "string",
          "maxLength": 40
        },
        "expectedReturnDate": {
          "type": "string",
          "maxLength": 40
        },
        "actualReturnDate": {
          "type": "string",
          "maxLength": 40
        },
        "status": {
          "type": "string",
          "enum": [
            "Pending Approval",
            "Released",
            "In Transit",
            "Received",
            "Returned",
            "Overdue"
          ],
          "maxLength": 32
        },
        "notes": {
          "type": "string",
          "maxLength": 1000
        },
        "ownerUid": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "equipmentId",
        "assetId",
        "equipmentName",
        "originDepartment",
        "originLocation",
        "destinationDepartment",
        "destinationLocation",
        "authorizingPerson",
        "releasingPerson",
        "receivingPerson",
        "movementDate",
        "expectedReturnDate",
        "actualReturnDate",
        "status",
        "notes",
        "ownerUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "MaintenanceTask": {
      "title": "MaintenanceTask",
      "description": "Preventive, corrective, calibration, or safety inspection maintenance task.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "equipmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
