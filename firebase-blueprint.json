          "type": "string",
          "pattern": "^[A-Z0-9\\-]+$",
          "maxLength": 32
        },
        "equipmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Z0-9\\-]+$",
          "maxLength": 32
        },
        "equipmentName": {
          "type": "string",
          "maxLength": 120
        },
        "reportingDepartment": {
          "type": "string",
          "maxLength": 80
        },
        "reportedBy": {
