  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private authenticated user profile documents with RBAC roles."
    },
    "/equipment/{equipmentId}": {
      "schema": { "$ref": "#/entities/EquipmentAsset" },
      "description": "Registered biomedical equipment assets scoped by ownerUid."
    },
    "/movements/{movementId}": {
      "schema": { "$ref": "#/entities/EquipmentMovement" },
      "description": "Equipment movement and chain-of-custody records scoped by ownerUid."
    },
    "/maintenanceTasks/{taskId}": {
      "schema": { "$ref": "#/entities/MaintenanceTask" },
      "description": "Scheduled and completed biomedical maintenance tasks scoped by ownerUid."
    },
    "/faultReports/{faultId}": {
      "schema": { "$ref": "#/entities/FaultReport" },
      "description": "Reported equipment faults and repair resolutions scoped by ownerUid."
    },
    "/historyEvents/{eventId}": {
      "schema": { "$ref": "#/entities/HistoryEvent" },
      "description": "Immutable chronological equipment history events scoped by ownerUid."
    }
  }
}
