    "HistoryEvent": {
      "title": "HistoryEvent",
      "description": "Immutable chronological equipment audit trail record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "equipmentId": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "maxLength": 128
        },
        "assetId": {
          "type": "string",
          "pattern": "^[A-Z0-9\\-]+$",
          "maxLength": 32
        },
        "eventType": {
          "type": "string",
          "maxLength": 64
        },
        "timestamp": {
          "type": "string",
          "maxLength": 40
        },
        "responsibleUser": {
          "type": "string",
          "maxLength": 100
        },
        "previousValue": {
          "type": "string",
          "maxLength": 160
        },
        "newValue": {
          "type": "string",
          "maxLength": 160
        },
