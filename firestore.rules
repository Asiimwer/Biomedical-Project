rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Reusable Hardened Primitives ---
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(uid) {
      return isVerified() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'timbrelplatforms@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidAssetCode(code) {
      return code is string && code.size() >= 2 && code.size() <= 32 && code.matches('^[A-Z0-9\\-]+$');
    }

    function isValidStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    function isNonEmptyStr(val, maxLen) {
      return val is string && val.size() >= 1 && val.size() <= maxLen;
    }

    // --- Validation Blueprints ---
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'department', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && isNonEmptyStr(data.email, 254)
        && isNonEmptyStr(data.displayName, 120)
        && data.role in ['Administrator', 'Biomedical Engineer', 'Department Personnel', 'Read-Only/Auditor']
        && isNonEmptyStr(data.department, 80)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEquipment(data) {
      return data.keys().hasAll([
          'id', 'assetId', 'name', 'category', 'manufacturer', 'model', 'serialNumber',
          'department', 'location', 'condition', 'status', 'responsibleParty', 'lastHandler',
          'lastMovementAt', 'acquisitionDate', 'lastServiceDate', 'nextServiceDate',
          'lastUpdated', 'notes', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'assetId', 'name', 'category', 'manufacturer', 'model', 'serialNumber',
          'department', 'location', 'condition', 'status', 'responsibleParty', 'lastHandler',
          'lastMovementAt', 'acquisitionDate', 'lastServiceDate', 'nextServiceDate',
          'lastUpdated', 'notes', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidAssetCode(data.assetId)
        && isNonEmptyStr(data.name, 120)
        && isNonEmptyStr(data.category, 64)
        && isNonEmptyStr(data.manufacturer, 80)
        && isNonEmptyStr(data.model, 80)
        && isNonEmptyStr(data.serialNumber, 64)
        && isNonEmptyStr(data.department, 80)
        && isValidStr(data.location, 120)
        && data.condition in ['Excellent', 'Good', 'Fair', 'Needs Repair', 'Unserviceable']
        && data.status in ['Operational', 'Faulty', 'Under Maintenance', 'Awaiting Inspection', 'Decommissioned']
        && isNonEmptyStr(data.responsibleParty, 100)
        && isNonEmptyStr(data.lastHandler, 100)
        && isValidStr(data.lastMovementAt, 40)
        && isValidStr(data.acquisitionDate, 32)
        && isValidStr(data.lastServiceDate, 32)
        && isValidStr(data.nextServiceDate, 32)
        && isValidStr(data.lastUpdated, 40)
        && isValidStr(data.notes, 1000)
        && isValidId(data.ownerUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMovement(data) {
      return data.keys().hasAll([
          'id', 'equipmentId', 'assetId', 'equipmentName', 'originDepartment', 'originLocation',
          'destinationDepartment', 'destinationLocation', 'authorizingPerson', 'releasingPerson',
          'receivingPerson', 'movementDate', 'expectedReturnDate', 'actualReturnDate',
          'status', 'notes', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'equipmentId', 'assetId', 'equipmentName', 'originDepartment', 'originLocation',
          'destinationDepartment', 'destinationLocation', 'authorizingPerson', 'releasingPerson',
          'receivingPerson', 'movementDate', 'expectedReturnDate', 'actualReturnDate',
          'status', 'notes', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.equipmentId)
        && isValidAssetCode(data.assetId)
        && isNonEmptyStr(data.equipmentName, 120)
        && isNonEmptyStr(data.originDepartment, 80)
        && isValidStr(data.originLocation, 120)
        && isNonEmptyStr(data.destinationDepartment, 80)
        && isNonEmptyStr(data.destinationLocation, 120)
        && isNonEmptyStr(data.authorizingPerson, 100)
        && isNonEmptyStr(data.releasingPerson, 100)
        && isNonEmptyStr(data.receivingPerson, 100)
        && isNonEmptyStr(data.movementDate, 40)
        && isValidStr(data.expectedReturnDate, 40)
        && isValidStr(data.actualReturnDate, 40)
        && data.status in ['Pending Approval', 'Released', 'In Transit', 'Received', 'Returned', 'Overdue']
        && isValidStr(data.notes, 1000)
        && isValidId(data.ownerUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMaintenanceTask(data) {
      return data.keys().hasAll([
          'id', 'equipmentId', 'assetId', 'equipmentName', 'type', 'lastMaintenanceDate',
          'nextMaintenanceDate', 'assignedEngineer', 'priority', 'status', 'instructions',
          'workPerformed', 'faultsDiscovered', 'partsReplaced', 'completionDate',
          'completedBy', 'postCondition', 'recommendations', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'equipmentId', 'assetId', 'equipmentName', 'type', 'lastMaintenanceDate',
          'nextMaintenanceDate', 'assignedEngineer', 'priority', 'status', 'instructions',
          'workPerformed', 'faultsDiscovered', 'partsReplaced', 'completionDate',
          'completedBy', 'postCondition', 'recommendations', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.equipmentId)
        && isValidAssetCode(data.assetId)
        && isNonEmptyStr(data.equipmentName, 120)
        && data.type in ['Preventive Maintenance', 'Corrective Maintenance', 'Inspection', 'Calibration', 'Safety Testing']
        && isValidStr(data.lastMaintenanceDate, 32)
        && isNonEmptyStr(data.nextMaintenanceDate, 32)
        && isNonEmptyStr(data.assignedEngineer, 100)
        && data.priority in ['Critical', 'High', 'Medium', 'Low']
        && data.status in ['Scheduled', 'In Progress', 'Completed', 'Overdue', 'Awaiting Parts']
        && isValidStr(data.instructions, 1000)
        && isValidStr(data.workPerformed, 1000)
        && isValidStr(data.faultsDiscovered, 1000)
        && isValidStr(data.partsReplaced, 500)
        && isValidStr(data.completionDate, 32)
        && isValidStr(data.completedBy, 100)
        && isValidStr(data.postCondition, 64)
        && isValidStr(data.recommendations, 1000)
        && isValidId(data.ownerUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFaultReport(data) {
      return data.keys().hasAll([
          'id', 'faultCode', 'equipmentId', 'assetId', 'equipmentName', 'reportingDepartment',
          'reportedBy', 'reportedAt', 'description', 'severity', 'status', 'assignedEngineer',
          'resolutionNotes', 'resolutionDate', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'faultCode', 'equipmentId', 'assetId', 'equipmentName', 'reportingDepartment',
          'reportedBy', 'reportedAt', 'description', 'severity', 'status', 'assignedEngineer',
          'resolutionNotes', 'resolutionDate', 'ownerUid', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidAssetCode(data.faultCode)
        && isValidId(data.equipmentId)
        && isValidAssetCode(data.assetId)
        && isNonEmptyStr(data.equipmentName, 120)
        && isNonEmptyStr(data.reportingDepartment, 80)
        && isNonEmptyStr(data.reportedBy, 100)
        && isNonEmptyStr(data.reportedAt, 40)
        && isNonEmptyStr(data.description, 1000)
        && data.severity in ['Critical', 'High', 'Medium', 'Low']
        && data.status in ['Reported', 'Under Investigation', 'Awaiting Parts', 'Under Repair', 'Resolved', 'Closed']
        && isValidStr(data.assignedEngineer, 100)
        && isValidStr(data.resolutionNotes, 1000)
        && isValidStr(data.resolutionDate, 40)
        && isValidId(data.ownerUid)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidHistoryEvent(data) {
      return data.keys().hasAll([
          'id', 'equipmentId', 'assetId', 'eventType', 'timestamp', 'responsibleUser',
          'previousValue', 'newValue', 'notes', 'ownerUid', 'createdAt'
        ])
        && data.keys().hasOnly([
          'id', 'equipmentId', 'assetId', 'eventType', 'timestamp', 'responsibleUser',
          'previousValue', 'newValue', 'notes', 'ownerUid', 'createdAt'
        ])
        && isValidId(data.id)
        && isValidId(data.equipmentId)
        && isValidAssetCode(data.assetId)
        && isNonEmptyStr(data.eventType, 64)
        && isNonEmptyStr(data.timestamp, 40)
        && isNonEmptyStr(data.responsibleUser, 100)
        && isValidStr(data.previousValue, 160)
        && isValidStr(data.newValue, 160)
        && isValidStr(data.notes, 1000)
        && isValidId(data.ownerUid)
        && data.createdAt is timestamp;
    }

    // --- Collection Rules ---
    match /admins/{uid} {
      allow get: if isValidId(uid) && (isOwner(uid) || isAdmin());
      allow list: if false;
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isVerified() && resource.data.uid == request.auth.uid;
      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (incoming().role in ['Biomedical Engineer', 'Department Personnel', 'Read-Only/Auditor'] || isAdmin());
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().role == existing().role
            && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'department', 'updatedAt'])
          )
        );
      allow delete: if isAdmin() && isValidId(userId);
    }

    match /equipment/{equipmentId} {
      allow get: if isVerified() && isValidId(equipmentId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(equipmentId)
        && isValidEquipment(incoming())
        && incoming().id == equipmentId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerified()
        && isValidId(equipmentId)
        && isValidEquipment(incoming())
        && incoming().id == existing().id
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'name', 'category', 'manufacturer', 'model', 'serialNumber',
                'department', 'location', 'condition', 'status', 'responsibleParty',
                'lastHandler', 'lastMovementAt', 'lastServiceDate', 'nextServiceDate',
                'lastUpdated', 'notes', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isVerified() && isValidId(equipmentId) && (existing().ownerUid == request.auth.uid || isAdmin());
    }

    match /movements/{movementId} {
      allow get: if isVerified() && isValidId(movementId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(movementId)
        && isValidMovement(incoming())
        && incoming().id == movementId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/equipment/$(incoming().equipmentId));
      allow update: if isVerified()
        && isValidId(movementId)
        && isValidMovement(incoming())
        && incoming().id == existing().id
        && incoming().equipmentId == existing().equipmentId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && existing().status != 'Returned'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'actualReturnDate', 'receivingPerson', 'notes', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(movementId);
    }

    match /maintenanceTasks/{taskId} {
      allow get: if isVerified() && isValidId(taskId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(taskId)
        && isValidMaintenanceTask(incoming())
        && incoming().id == taskId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/equipment/$(incoming().equipmentId));
      allow update: if isVerified()
        && isValidId(taskId)
        && isValidMaintenanceTask(incoming())
        && incoming().id == existing().id
        && incoming().equipmentId == existing().equipmentId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && existing().status != 'Completed'
            && (
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'assignedEngineer', 'priority', 'nextMaintenanceDate', 'instructions', 'updatedAt'
              ]) ||
              incoming().diff(existing()).affectedKeys().hasOnly([
                'status', 'lastMaintenanceDate', 'nextMaintenanceDate', 'workPerformed',
                'faultsDiscovered', 'partsReplaced', 'completionDate', 'completedBy',
                'postCondition', 'recommendations', 'updatedAt'
              ])
            )
          )
        );
      allow delete: if isAdmin() && isValidId(taskId);
    }

    match /faultReports/{faultId} {
      allow get: if isVerified() && isValidId(faultId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(faultId)
        && isValidFaultReport(incoming())
        && incoming().id == faultId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && existsAfter(/databases/$(database)/documents/equipment/$(incoming().equipmentId));
      allow update: if isVerified()
        && isValidId(faultId)
        && isValidFaultReport(incoming())
        && incoming().id == existing().id
        && incoming().equipmentId == existing().equipmentId
        && incoming().ownerUid == existing().ownerUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid
            && existing().status != 'Closed'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'assignedEngineer', 'resolutionNotes', 'resolutionDate', 'updatedAt'
            ])
          )
        );
      allow delete: if isAdmin() && isValidId(faultId);
    }

    match /historyEvents/{eventId} {
      allow get: if isVerified() && isValidId(eventId) && (existing().ownerUid == request.auth.uid || isAdmin());
      allow list: if isVerified() && resource.data.ownerUid == request.auth.uid;
      allow create: if isVerified()
        && isValidId(eventId)
        && isValidHistoryEvent(incoming())
        && incoming().id == eventId
        && incoming().ownerUid == request.auth.uid
        && incoming().createdAt == request.time
        && existsAfter(/databases/$(database)/documents/equipment/$(incoming().equipmentId));
      allow update: if false;
      allow delete: if false;
    }
  }
}
